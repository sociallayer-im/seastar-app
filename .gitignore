# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.production
# The CN deploy pipeline parks the SG file here while it builds with the CN
# values. It exists for the length of every CN deploy and is a verbatim copy of
# .env.production, secrets included — a `git add -A` in that window would
# commit them.
.env.production.sgbak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEA
.idea

.vercel
.env.cn.production
