# Environment variables
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_FIELD=solar_auth
NEXT_PUBLIC_GRAPH_URL=https://graph.sola.day/v1/graphql
# Empty = the auth screens are served by this app (same origin, no cross-site
# hop). Set it to an external auth origin to fall back to the old standalone app.
NEXT_PUBLIC_SIGN_IN_URL=
NEXT_PUBLIC_CLIENT_MODE=prod
NEXT_PUBLIC_APP_TITLE="Social Layer"
NEXT_PUBLIC_ENABLE_GOOGLE_MAP=true
NEXT_PUBLIC_APP_LOGO=
NEXT_PUBLIC_ICP_LICENSE=""
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=

NEXT_PUBLIC_STRIPE_ENABLED=true

# Discussion boards. soon's DISCUSSION_ENABLED is the real switch; this only
# draws the UI. Left on in dev so the tab is reachable locally.
NEXT_PUBLIC_DISCUSSION=true

# Opt-out (absent = on). CN sets both to "false"; see src/app/config.ts.
NEXT_PUBLIC_WALLET_LOGIN=true
NEXT_PUBLIC_CRYPTO_PAYMENT_ENABLED=true

# Google sign-in. Needs NEXT_TOKEN server-side and this origin registered as an
# authorized JavaScript origin on the OAuth client.
NEXT_PUBLIC_THIRD_PARTY_LOGIN=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_TOKEN=

# Host normalisation. Empty here (and in .env.cn.production) means "no
# redirect", which is what local dev and CN both want — CN's canonical host is
# www.juluo.xyz and it must not bounce anywhere. SG sets these in
# .env.production. See src/middleware.ts.
NEXT_PUBLIC_CANONICAL_HOST=
NEXT_PUBLIC_CANONICAL_REDIRECT_HOSTS=
